# Copy to .env. Use a long random URL-safe password (letters/digits recommended).
POSTGRES_PASSWORD=
# Optional external database override; leave unset for the bundled PostgreSQL.
# DATABASE_URL=postgresql+psycopg://user:password@hostname:5432/trading_lab
WEB_PORT=8080
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Use paper-account key ID + secret. Historical bars use https://data.alpaca.markets/v2.
# https://paper-api.alpaca.markets/v2 is the paper account/trading API, not the bar-data API.
WORKER_LEASE_SECONDS=120
WORKER_POLL_SECONDS=2
WORKER_MAX_RUN_SECONDS=1800
MAX_ACTIVE_JOBS=20
MAX_DATASET_ROWS=100000
MAX_REQUEST_BYTES=25000000
